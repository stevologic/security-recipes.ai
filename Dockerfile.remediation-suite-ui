# syntax=docker/dockerfile:1.7

FROM python:3.14-slim

LABEL org.opencontainers.image.title="security-recipes remediation suite dashboard" \
      org.opencontainers.image.description="Dockerized browser workbench for configuring and running the security-recipes.ai Python remediation suite." \
      org.opencontainers.image.source="https://github.com/stevologic/security-recipes.ai"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SECURITY_RECIPES_DASHBOARD_HOST=0.0.0.0 \
    SECURITY_RECIPES_DASHBOARD_PORT=8787 \
    SECURITY_RECIPES_DASHBOARD_STATE_DIR=/data

WORKDIR /app

# The dashboard needs only the suite entrypoint, its package (incl. the ui/
# assets), and the domain registry — not the whole repo. Targeted copies keep
# the build context transfer small and mean site content changes never
# invalidate this image.
COPY scripts/security_recipes_remediation_suite.py /app/scripts/security_recipes_remediation_suite.py
COPY tools/security_recipes_remediation /app/tools/security_recipes_remediation
COPY data/remediation_suite /app/data/remediation_suite

RUN mkdir -p /data

EXPOSE 8787

VOLUME ["/data"]

# Heredocs are only valid in RUN/COPY, so the health probe stays a one-liner.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import json, urllib.request; payload = json.loads(urllib.request.urlopen('http://127.0.0.1:8787/api/health', timeout=2).read().decode('utf-8')); raise SystemExit(0 if payload.get('status') == 'ok' else 1)" || exit 1

CMD ["sh", "-c", "python scripts/security_recipes_remediation_suite.py serve-dashboard --host ${SECURITY_RECIPES_DASHBOARD_HOST} --port ${SECURITY_RECIPES_DASHBOARD_PORT} --state-dir ${SECURITY_RECIPES_DASHBOARD_STATE_DIR}"]
