{
  "agent_trust_fabric_pack_id": "security-recipes.agent-trust-fabric.v1",
  "commercialization_path": {
    "acquirer_value": "A frontier lab, AI platform, or security vendor gets a standards-backed agent trust surface that can sit between agents, MCP tools, context stores, telemetry, and trust centers.",
    "enterprise_layer": "Sell hosted trust-fabric APIs that combine customer-private identity, telemetry, authorization, egress, approval, and receipt data into signed MCP-readable trust verdicts.",
    "open_layer": "Publish the Agent Trust Fabric pack as open evidence so teams can understand the trust decision model and fork it into their own control plane."
  },
  "enterprise_adoption_packet": {
    "board_level_claim": "SecurityRecipes can reduce agent adoption friction by turning many scattered agent safety controls into one inspectable trust verdict per run.",
    "default_questions_answered": [
      "Which agent is asking for context or tool access?",
      "Which workflow and trust tier does the run belong to?",
      "Which evidence proves identity, context, scope, behavior, egress, and containment?",
      "Should the runtime allow, hold, deny, or kill the run?",
      "Which source packs and MCP tools explain the decision?"
    ],
    "recommended_first_use": "Use the open pack for AI platform architecture review, then attach the evaluator to MCP gateway decisions and customer pilot telemetry.",
    "sales_motion": "Lead with the open trust-fabric pack, then sell hosted customer-specific trust scoring, policy adapters, signed verdicts, SOC export, and trust-center evidence APIs."
  },
  "executive_readout": {
    "board_level_claim": "SecurityRecipes can reduce agent adoption friction by turning many scattered agent safety controls into one inspectable trust verdict per run.",
    "recommended_first_use": "Use the open pack for AI platform architecture review, then attach the evaluator to MCP gateway decisions and customer pilot telemetry.",
    "why_it_is_differentiated": "Most agent guidance stops at controls. The trust fabric composes generated evidence into an allow, hold, deny, or kill decision that agents and auditors can consume."
  },
  "failures": [],
  "generated_at": "2026-09-07",
  "positioning": {
    "buyer": "AI platform, product security, CISO, GRC, model-risk, SOC, procurement-security, and acquisition diligence teams",
    "category": "Agentic AI zero-trust decision fabric",
    "enterprise_promise": "SecurityRecipes can answer the board-level question 'which agents can we trust right now?' with generated evidence, source hashes, runtime decisions, and MCP tools instead of narrative policy.",
    "why_now": "2026 agent deployments are moving from pilots to autonomous action. NIST's August 27, 2026 identity guidance warns that shared human credentials, long-lived API keys, and local user-account impersonation recreate classic IAM failures at agent scale. Every agent still needs a unique identity, least-privilege scope, governed context, telemetry, and fast containment."
  },
  "runtime_policy": {
    "decision_order": [
      "kill_session_on_agent_trust_break",
      "deny_untrusted_agent",
      "hold_for_trust_evidence",
      "hold_for_step_up",
      "allow_trusted_agent_context"
    ],
    "deny_when": [
      "workflow is unknown",
      "requested trust tier exceeds generated workflow tier and no approval exists",
      "required evidence fields are missing after normalization",
      "trust score falls below deny threshold",
      "agent authenticates with a long-lived static API key or unconstrained bearer token"
    ],
    "kill_when": [
      "token passthrough is observed",
      "delegated identity was used after revocation",
      "agent is using a shared human credential instead of a unique agent identity",
      "agent is impersonating a local user account",
      "secret egress or cross-tenant context access is observed",
      "runtime kill signal is present",
      "prompt injection is combined with external side effect",
      "agent repeats a denied action"
    ],
    "step_up_required_when": [
      "requested_trust_tier is operator or principal and human approval is absent",
      "authorization_decision, egress_decision, action_runtime_decision, or telemetry_decision is hold",
      "source_freshness_decision is review_due or stale_or_missing",
      "scope_escalation is requested",
      "cross_tenant_context_access is requested",
      "external_side_effect is requested"
    ]
  },
