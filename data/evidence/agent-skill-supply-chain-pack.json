  "enterprise_adoption_packet": {
    "board_level_claim": "SecurityRecipes can prove which agent skills are trusted enough to install or run, and can block untrusted behavior packages before they inherit MCP, filesystem, shell, memory, or network authority.",
    "default_questions_answered": [
      "Which agent skills are installed or proposed?",
      "Who published and owns each skill?",
      "Which skills are pinned, signed, scanned, and hash verified?",
      "Which skills combine private data access, untrusted content, and network egress?",
      "Which skills fetch external documents as instructions, and are those sources pinned, hashed, allowlisted, or inlined?",
      "Which skills require human approval, sandboxing, or denial?",
      "Which runtime decision should an MCP gateway make before install, update, or run?"
    ],
    "recommended_first_use": "Attach this pack to AI platform intake, agent-host hardening, skill marketplace approval, MCP gateway policy review, and quarterly agent workspace recertification.",
    "sales_motion": "Lead with open skill provenance and runtime decisions, then sell hosted skill inventory ingestion, registry transparency checks, semantic skill scanning, signed package admission, sandbox policies, and trust-center exports."
  },
  "failures": [],
  "generated_at": "2026-08-28",
  "intent": "Define an enterprise-ready supply-chain model for agentic skills, rules files, hooks, and tool bundles so SecurityRecipes can govern the behavior layer between model prompts and MCP tool execution. The model turns skill provenance, permissions, registry trust, version pinning, isolation, referenced-instruction integrity, and runtime evidence into deterministic install, update, and run decisions.",
  "positioning": {
    "buyer": "AI Platform, Security Engineering, Product Security, AppSec, GRC, procurement security, vendor-risk, and acquisition diligence teams",
    "category": "Agent skill provenance, permission, and isolation firewall",
    "enterprise_promise": "SecurityRecipes can inventory agent skills across Claude Code, Cursor, Codex, Devin, VS Code, and MCP-adjacent ecosystems, prove which behaviors are pinned and reviewed, and block untrusted skills before they reach agents with filesystem, network, memory, shell, or MCP authority.",
    "why_now": "Agentic AI risk is moving from isolated prompts to reusable behavior packages. Skills, rules files, hooks, extensions, and MCP tool bundles can quietly combine private data, untrusted instructions, and external egress. OWASP AST05 names a distinct skill failure: a URL or remote file that the agent treats as trusted instructions after the signed package has already been reviewed. Enterprises need a default-deny admission layer before these packages become trusted execution context."
  },
  "residual_risks": [
    {
      "risk": "The open pack models declared skills, not a live customer endpoint inventory.",
      "treatment": "Production deployments should ingest installed skill manifests, hashes, host versions, registry metadata, and gateway logs before enforcement."
    },
    {
      "risk": "Static manifest scanning cannot prove natural-language skill behavior is benign.",
      "treatment": "Pair this pack with semantic review, behavioral sandbox runs, red-team prompts, and runtime egress monitoring."
    },
    {
      "risk": "A skill can become unsafe after a publisher, dependency, registry, or host update.",
      "treatment": "Disable unpinned auto-updates and regenerate this pack whenever package hashes, permissions, scans, or host runtimes change."
    },
    {
      "risk": "A skill can keep a pinned package hash while a referenced URL or remote file changes and is treated as trusted instructions.",
      "treatment": "Inventory external instruction sources, inline snapshots or pin review-time content hashes, allowlist fetch hosts, refuse unpinned or drifted documents, and rescan referenced content continuously."
    }
  ],
