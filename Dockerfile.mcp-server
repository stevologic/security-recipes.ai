# syntax=docker/dockerfile:1.7
FROM python:3.14-slim

ARG REVISION="bootstrap"

LABEL org.opencontainers.image.title="security-recipes.ai MCP server" \
      org.opencontainers.image.source="https://github.com/stevologic/security-recipes.ai" \
      org.opencontainers.image.revision="${REVISION}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RECIPES_MCP_CONFIG=/app/mcp-server.toml \
    RECIPES_MCP_TRANSPORT=streamable-http \
    RECIPES_MCP_HOST=0.0.0.0 \
    RECIPES_MCP_PORT=80 \
    RECIPES_MCP_PATH=/mcp \
    RECIPES_MCP_CVE_SEARCH_DB_PATH=/app/runtime/cve-search.sqlite3 \
    RECIPES_MCP_REQUIRE_CVE_SEARCH_DATABASE=true \
    RECIPES_PUBLIC_SITE_BASE_URL=https://security-recipes.ai/

WORKDIR /app

# The pip cache mount persists wheels across builds, so a requirements change
# reinstalls from the local cache instead of the network.
COPY requirements-mcp-server.txt /app/requirements-mcp-server.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /app/requirements-mcp-server.txt

# Copy default config if the caller doesn't mount one.
COPY mcp-server.toml.example /app/mcp-server.toml.example
RUN cp /app/mcp-server.toml.example /app/mcp-server.toml

# Server code, then data last: evidence packs churn with recipe ingests and
# should invalidate as few layers as possible.
COPY mcp_server.py /app/mcp_server.py
COPY scripts/cve_text_quality.py /app/scripts/cve_text_quality.py
COPY scripts/build_cve_search_db.py /app/scripts/build_cve_search_db.py
COPY scripts/cve_search_runtime.py /app/scripts/cve_search_runtime.py
COPY data /app/data
COPY static/api/cve-catalog /app/static/api/cve-catalog

RUN mkdir -p /app/runtime && \
    python /app/scripts/build_cve_search_db.py \
    --catalog /app/static/api/cve-catalog \
    --output /app/runtime/cve-search.sqlite3 \
    --metadata-output /app/runtime/cve-search.sqlite3.metadata.json

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=8s --start-period=30s --retries=20 \
    CMD python -c "import os, urllib.request as u; base=os.environ.get('RECIPES_PUBLIC_SITE_BASE_URL', 'https://security-recipes.ai/').rstrip('/'); canonical=f'<link rel=\"canonical\" href=\"{base}/cve/CVE-2024-3400/\">'.encode(); r=u.urlopen('http://127.0.0.1/cve/CVE-2024-3400/', timeout=5); b=r.read(262144); assert r.status == 200 and canonical in b and b'<meta name=\"robots\" content=\"index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1\">' in b and b'data-cve-id=\"CVE-2024-3400\"' in b and b'id=\"remediation-authority-heading\"' in b and b'id=\"use-ai-heading\"' in b and b'\"@type\":\"Article\"' in b and b'\"additionalType\":\"https://schema.org/TechArticle\"' in b" || exit 1

CMD ["python", "/app/mcp_server.py"]
