<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
{% set pageDates = {
  cve: cve,
  date: date,
  lastmod: lastmod,
  disclosed: disclosed,
  sourcePath: sourcePath
} | articleDates %}
<title>{{ title | seoTitle | escape }}</title>
{{ {
  url: page.url,
  title: title,
  description: description,
  tags: tags,
  author: author,
  image: image,
  noindex: noindex,
  noindexFollow: noindex_follow,
  keywords: keywords,
  cve: cve,
  canonicalCveRoute: canonical_cve_route,
  date: date,
  lastmod: lastmod,
  disclosed: disclosed,
  imageWidth: image_width,
  imageHeight: image_height,
  howTo: how_to,
  breadcrumbParent: breadcrumb_parent,
  sourcePath: sourcePath,
  isHome: false,
  isSection: isSection,
  isArticle: isArticle,
  isError: isError
} | seoHead | safe }}
{% if isSection and sectionFeed %}<link rel="alternate" type="application/rss+xml" href="{{ page.url }}index.xml" title="{{ title | presentationText | escape }} – {{ site.title | escape }}">{% endif %}
{% include "partials/head-common.njk" %}
</head>
{% set isCveDetail = page.url and page.url.startsWith("/recipes/cve/") and page.url != "/recipes/cve/" %}
<body class="sr-docs-body{% if isCveDetail %} sr-cve-detail-page{% endif %}"{% if isCveDetail %} data-cve-detail-page="true"{% endif %}>
{% include "partials/navbar.njk" %}
<div class="hextra-max-page-width sr-shell">
  <aside class="hextra-sidebar-container sr-sidebar" aria-label="Site sections">
    <nav class="hextra-sidebar">
      {{ page.url | sidebarHtml | safe }}
    </nav>
  </aside>
  <main id="content" class="hextra-content sr-main">
    {% set crumbs = page.url | breadcrumbs(breadcrumb_parent) %}
    {% if crumbs.length %}
    <nav class="sr-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {% for c in crumbs %}<span aria-hidden="true">/</span><a href="{{ c.url }}">{{ c.title }}</a>{% endfor %}
    </nav>
    {% endif %}
    {% set provenanceModel = model or model_used %}
    {% if isCveDetail %}
    {% set detailTitleSource = title %}
    {% if known_as and known_as.length %}{% set detailTitleSource = known_as[0] %}{% endif %}
    {% set detailTitle = detailTitleSource | cveDisplayTitle(cve) %}
    <header class="sr-cve-detail-header">
      <div class="sr-cve-detail-header__topline">
        <p class="sr-cve-detail-header__kicker"><span aria-hidden="true"></span>{{ cve or "CVE intelligence record" }}</p>
        <a href="/cve-database/#cve-catalog">Back to CVE Database <span aria-hidden="true">→</span></a>
      </div>
      {% if title %}<h1 class="sr-page-title sr-cve-detail-header__title">{{ detailTitle | presentationText | escape }}</h1>{% endif %}
      {% if description %}<p class="sr-cve-detail-header__summary">{{ description | presentationText | escape }}</p>{% endif %}
      <dl class="sr-cve-detail-header__signals" aria-label="Vulnerability record metadata">
        {% if severity %}<div class="sr-cve-detail-header__signal sr-cve-detail-header__signal--severity-{{ severity | lower }}"><dt>Severity</dt><dd>{{ severity | upper }}</dd></div>{% endif %}
        {% if kev %}<div class="sr-cve-detail-header__signal sr-cve-detail-header__signal--kev"><dt>Priority</dt><dd>CISA KEV</dd></div>{% endif %}
        {% if ecosystem %}<div class="sr-cve-detail-header__signal"><dt>Ecosystem</dt><dd>{{ ecosystem }}</dd></div>{% endif %}
        {% if disclosed %}<div class="sr-cve-detail-header__signal"><dt>Disclosed</dt><dd>{{ disclosed | isoDate }}</dd></div>{% endif %}
        {% if maturity %}<div class="sr-cve-detail-header__signal"><dt>Status</dt><dd>{{ maturity }}</dd></div>{% endif %}
        {% if ghsa %}<div class="sr-cve-detail-header__signal"><dt>GHSA</dt><dd>{{ ghsa }}</dd></div>{% endif %}
      </dl>
      {% if provenanceModel %}
      <div class="sr-page-provenance">
        <span class="sr-ai-provenance" title="{% if ai_assisted %}AI-enriched{% else %}Tested with{% endif %} {{ provenanceModel | escape }}" aria-label="{% if ai_assisted %}AI-enriched{% else %}Tested with{% endif %} {{ provenanceModel | escape }}">
          <span class="sr-ai-provenance__icon" aria-hidden="true">✦</span>
          <span class="sr-ai-provenance__label">{% if ai_assisted %}AI-enriched{% else %}Tested with{% endif %}</span>
          <code>{{ provenanceModel | escape }}</code>
        </span>
        <span>{% if ai_assisted %}Supplemental guidance includes model-generated content.{% else %}Model compatibility is recorded; source facts remain human-verifiable.{% endif %}</span>
      </div>
      {% endif %}
    </header>
    {% else %}
    {% if title and page.url != "/cve-database/" %}<h1 class="sr-page-title">{{ title | presentationText | escape }}</h1>{% endif %}
    {% if provenanceModel %}
    <div class="sr-page-provenance">
      <span class="sr-ai-provenance" title="{% if ai_assisted %}AI-enriched{% else %}Tested with{% endif %} {{ provenanceModel | escape }}" aria-label="{% if ai_assisted %}AI-enriched{% else %}Tested with{% endif %} {{ provenanceModel | escape }}">
        <span class="sr-ai-provenance__icon" aria-hidden="true">✦</span>
        <span class="sr-ai-provenance__label">{% if ai_assisted %}AI-enriched{% else %}Tested with{% endif %}</span>
        <code>{{ provenanceModel | escape }}</code>
      </span>
      <span>{% if ai_assisted %}Supplemental guidance includes model-generated content.{% else %}Model compatibility is recorded; source facts remain human-verifiable.{% endif %}</span>
    </div>
    {% endif %}
    {% endif %}
    {% set renderedContent = content %}
    {% if title and page.url != "/cve-database/" %}{% set renderedContent = content | stripFirstH1 %}{% endif %}
    <div class="content{% if isCveDetail %} sr-cve-detail-content{% endif %}">
{{ renderedContent | safe }}
    {% if page.url == "/recipes/" or page.url == "/cve-database/" or page.url == "/mcp-servers/" %}
    {% include "partials/recipe-chat.njk" %}
    {% endif %}
    </div>
    {% if isArticle and not isError %}
    {% set attributionName = author or site.seo.author %}
    {% set attributionKey = attributionName | lower %}
    {% set knownAuthor = site.seo.knownAuthors[attributionName] %}
    {% set isAiAttribution = attributionKey == "codex" or attributionKey == "chatgpt" or attributionKey == "claude" or attributionKey == "gemini" or attributionKey == "copilot" or "ai-assisted" in attributionKey or "artificial intelligence" in attributionKey or "language model" in attributionKey or "openai" in attributionKey or "anthropic" in attributionKey %}
    {% set isCollectiveAttribution = not author or "contributor" in attributionKey or "maintainer" in attributionKey or "editorial team" in attributionKey or "editorial board" in attributionKey or attributionKey == "security recipes" or attributionKey == "security-recipes.ai" %}
    <aside class="sr-page-provenance" aria-label="Authorship and review">
      <strong>Authorship and review</strong>
      {% if isAiAttribution %}
      <span>Editorial owner: <a href="/about/">{{ site.seo.author }}</a></span>
      <span>AI assistance: {{ attributionName | escape }}</span>
      {% elif isCollectiveAttribution %}
      <span>By <a href="/about/">{{ attributionName | escape }}</a></span>
      {% else %}
      <span>By {% if knownAuthor %}<a href="{{ knownAuthor.url | escape }}">{{ attributionName | escape }}</a>{% else %}{{ attributionName | escape }}{% endif %}</span>
      <span>Editorial standard: <a href="/about/">Security Recipes contributors</a></span>
      {% endif %}
      {% if pageDates.datePublished %}<span>Published <time datetime="{{ pageDates.datePublished }}">{{ pageDates.datePublished | isoDate }}</time></span>{% endif %}
      {% if pageDates.dateModified %}<span>Last updated <time datetime="{{ pageDates.dateModified }}">{{ pageDates.dateModified | isoDate }}</time></span>{% endif %}
      <a href="/about/#editorial-principles">Review methodology</a>
      <a href="/about/#corrections">Corrections policy</a>
    </aside>
    {% endif %}
    {% set pager = page.inputPath | pagerFor %}
    {% if pager.prev or pager.next %}
    <nav class="hextra-pagination sr-pager" aria-label="Pagination">
      {% if pager.prev %}<a class="hextra-pager sr-pager__prev" href="{{ pager.prev.url }}" rel="prev"><span aria-hidden="true">←</span> {{ pager.prev.title | presentationText | escape }}</a>{% else %}<span></span>{% endif %}
      {% if pager.next %}<a class="hextra-pager sr-pager__next" href="{{ pager.next.url }}" rel="next">{{ pager.next.title | presentationText | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </nav>
    {% endif %}
  </main>
  <nav class="hextra-toc sr-toc" aria-label="On this page">
    {% set toc = renderedContent | tocEntries %}
    {% if toc.length %}
    <p class="sr-toc__title">On this page</p>
    <ul>
      {% for entry in toc %}
      <li class="sr-toc__l{{ entry.level }}"><a href="#{{ entry.id }}">{{ entry.text }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if tags and tags.length %}
    <div class="sr-toc__tags">
      {% for tag in tags %}
      {% set tagUrl = tag | authoredTagUrl %}
      {% if tagUrl %}<a class="sr-tag-chip sr-tag-chip--small" href="{{ tagUrl }}">{{ tag | escape }}</a>{% else %}<span class="sr-tag-chip sr-tag-chip--small">{{ tag | escape }}</span>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </nav>
</div>
<footer class="hextra-footer">
  <div class="sr-footer-inner">
    <div class="sr-footer-meta"><span>{{ site.footer.copyright }}</span><a href="/about/">About &amp; editorial policy</a></div>
    {% include "partials/footer-donations.njk" %}
  </div>
</footer>
<script>
(function () {
  var links = document.querySelectorAll('.sr-sidebar a, .sr-nav__links a');
  var navigationPath = location.pathname.indexOf('/cve/') === 0 ||
    (location.pathname.indexOf('/recipes/cve/') === 0 && location.pathname !== '/recipes/cve/')
      ? '/cve-database/'
      : location.pathname;
  for (var i = 0; i < links.length; i++) {
    if (links[i].getAttribute('href') === navigationPath) {
      links[i].setAttribute('aria-current', 'page');
    }
  }
})();
</script>
</body>
</html>
