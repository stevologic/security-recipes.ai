<section class="recipe-chat" data-recipe-chat hidden>
  <div class="recipe-chat__panel">
    <header class="recipe-chat__head">
      <p class="recipe-chat__eyebrow">Read-only</p>
      <h2 class="recipe-chat__title">Recipe chat</h2>
      <p class="recipe-chat__lede">Answers from published recipes, CVE pages, playbooks, and MCP setup docs. This is not a scanner, autofix, or deployer.</p>
    </header>
    <div class="recipe-chat__log" data-recipe-chat-log aria-live="polite"></div>
    <p class="recipe-chat__quota" data-recipe-chat-quota></p>
    <form class="recipe-chat__composer" data-recipe-chat-form>
      <label class="recipe-chat__label" for="recipe-chat-input">Message</label>
      <textarea id="recipe-chat-input" class="recipe-chat__input" data-recipe-chat-input rows="3" maxlength="2000" placeholder="Ask about a published recipe, CVE, playbook, or MCP setup page."></textarea>
      <div class="recipe-chat__actions">
        <button type="submit" class="recipe-chat__send" data-recipe-chat-send>Send</button>
        <button type="button" class="recipe-chat__unlock" data-recipe-chat-unlock hidden>Unlock 100 messages for $5</button>
      </div>
    </form>
    <p class="recipe-chat__status" data-recipe-chat-status aria-live="polite"></p>
  </div>
</section>
