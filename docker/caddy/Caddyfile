# Caddy reverse proxy for the security-recipes.ai compose stack.
#
# Caddy obtains the Let's Encrypt certificate for SECURITY_RECIPES_DOMAIN
# automatically on first start and renews it in the background; certificates
# persist in the caddy_data volume across deploys. Enabled through the
# "caddy" compose profile (COMPOSE_PROFILES=caddy in .env).
#
# Placeholders come from the caddy service environment in docker-compose.yml.
{
	email {$SECURITY_RECIPES_ACME_EMAIL:admin@security-recipes.ai}
}

{$SECURITY_RECIPES_DOMAIN:security-recipes.ai} {
	encode zstd gzip

	# Structured access logs feed the public, aggregate-only GoAccess report.
	# IP addresses are anonymized by the report generator before publication.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# deploy.sh supplies the active slot and, only when revision-verified, the
	# previous release as fallback. It deliberately expands the fallback token
	# to empty while that container is being replaced.
	reverse_proxy {$SECURITY_RECIPES_PRIMARY_UPSTREAM:security-recipes:80} {$SECURITY_RECIPES_FALLBACK_UPSTREAM:security-recipes-green:80} {
		lb_policy first
		health_uri /
		health_interval 5s
		health_timeout 2s
		health_status 200
		health_fails 1
		health_passes 2
		fail_duration 30s
		max_fails 1
		unhealthy_status 5xx
		lb_try_duration 5s
		lb_try_interval 100ms
		stream_close_delay 5m
	}
}

# Consolidate backlinks and accidental visits to one canonical HTTPS host.
# The www DNS record already resolves to this deployment, so Caddy must obtain
# a certificate before redirecting; redirecting HTTP to a broken HTTPS www
# endpoint strands both users and crawlers at the TLS handshake.
www.{$SECURITY_RECIPES_DOMAIN:security-recipes.ai} {
	redir https://{$SECURITY_RECIPES_DOMAIN:security-recipes.ai}{uri} permanent
}
