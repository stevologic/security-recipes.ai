# security-recipes MCP server configuration

# URL or local file path to the generated recipe feed from your site build.
# Prefer /api/recipes-index.json: the lean MCP index (full bodies + metadata,
# without the per-recipe agent boilerplate). The rich /api/recipes.json and the
# legacy /recipes-index.json array are still accepted for compatibility.
source_index_url = "https://security-recipes.ai/api/recipes-index.json"

# Complete Medium/High/Critical CVE catalog. Docker builds copy this directory into
# the same path so exact-CVE lookups stay local and do not depend on NVD uptime.
cve_catalog_path = "./static/api/cve-catalog"

# Agent-ready workflow registry shared with the playbook pages and Python suite.
# These MCP tools are planning-only: recipes_playbooks_list,
# recipes_playbook_get, and recipes_playbook_plan.
playbook_registry_path = "./data/remediation_suite/playbooks.json"

# Security allow-list: hostname from source_index_url MUST exist here.
allowed_source_hosts = ["security-recipes.ai"]

# Public URL where this MCP server itself is hosted (metadata only).
# Change this to your own hostname/subdomain when self-hosting.
server_public_base_url = "https://mcp.security-recipes.ai"

# Optional upstream MCP context servers.
#
# No upstream servers are configured by default because these connections often
# require business credentials. Self-hosted deployments can opt in by adding one
# table per approved HTTP or Streamable HTTP MCP endpoint. Keep secrets in
# environment variables and pin allowed_tools for production.
#
# [[upstream_mcp_servers]]
# id = "github"
# label = "GitHub MCP Server"
# description = "Repository, issue, PR, Actions, and code-security context."
# url = "https://YOUR-GITHUB-MCP-ENDPOINT/mcp"
# auth_token_env = "GITHUB_TOKEN"
# allowed_tools = ["search_repositories", "get_issue", "get_pull_request"]
# context_tool = "search_repositories"
# context_query_argument = "query"
# max_response_chars = 12000
#
# [[upstream_mcp_servers]]
# id = "semgrep-docs"
# label = "Semgrep docs MCP"
# description = "Semgrep documentation and rule guidance."
# url = "https://YOUR-SEMGREP-MCP-ENDPOINT/mcp"
# allowed_tools = ["search"]
# context_tool = "search"
# context_query_argument = "query"
#
# If you intentionally operate an internal read-only gateway, you may allow
# unlisted read-like tool names instead of pinning every name. Prefer explicit
# allowed_tools whenever the upstream can access tenant, cloud, or source data.
#
# [[upstream_mcp_servers]]
# id = "security-gateway"
# label = "Internal security MCP gateway"
# url = "https://mcp.example.com/security/mcp"
# auth_token_env = "SECURITY_MCP_TOKEN"
# allow_unlisted_read_only_tools = true
# blocked_tools = ["create_issue", "write_file", "run_command"]
# context_tool = "search"
# context_query_argument = "query"

# Local workflow-control-plane manifest exposed through the
# recipes_workflow_control_plane MCP tool.
control_plane_manifest_path = "./data/control-plane/workflow-manifests.json"

# Generated policy pack exposed through the recipes_mcp_gateway_policy MCP tool.
gateway_policy_path = "./data/policy/mcp-gateway-policy.json"

# Generated assurance pack exposed through the recipes_agentic_assurance_pack MCP tool.
assurance_pack_path = "./data/evidence/agentic-assurance-pack.json"

