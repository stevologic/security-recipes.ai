# DigitalOcean droplet / Docker Compose settings.
# Copy to .env on the droplet and edit values before `docker compose up -d --build`.
# Use the Docker Compose v2 plugin (`docker compose`). The legacy Python
# `docker-compose` v1 can crash on newer Docker image metadata.

# Public site URL used by the Eleventy build for absolute links.
SECURITY_RECIPES_BASE_URL=https://security-recipes.ai/
SECURITY_RECIPES_REPO_URL=https://github.com/stevologic/security-recipes.ai

# Bundled Caddy HTTPS proxy (docker/caddy/Caddyfile). With the profile on,
# `docker compose up -d --build` also starts Caddy: it owns ports 80/443,
# obtains the Let's Encrypt certificate for SECURITY_RECIPES_DOMAIN
# automatically, and renews it in the background. Remove the COMPOSE_PROFILES
# line if a host-level proxy (nginx + certbot, or host Caddy from
# scripts/setup_digitalocean_droplet.sh) already owns 80/443.
COMPOSE_PROFILES=caddy
SECURITY_RECIPES_DOMAIN=security-recipes.ai
SECURITY_RECIPES_ACME_EMAIL=admin@security-recipes.ai
# Opt in to deploy.sh-managed Compose Fail2Ban. This requires bundled Caddy
# and must not be enabled while the host security-recipes-caddy-404 jail is
# installed. deploy.sh pulls, starts, health-checks, and updates the container.
DEPLOY_COMPOSE_FAIL2BAN=false
# Host bind for the site container. Keep it loopback-only when a public nginx
# or Caddy reverse proxy owns ports 80/443. See README.nginx-letsencrypt.md for
# the nginx + Certbot deployment flow.
SECURITY_RECIPES_HTTP_PORT=127.0.0.1:8080
# Warm standby used by deploy.sh for zero-downtime blue/green releases.
SECURITY_RECIPES_GREEN_HTTP_PORT=127.0.0.1:8081
# Staging slot for origin/development at https://dev.security-recipes.ai/.
SECURITY_RECIPES_DEV_HTTP_PORT=127.0.0.1:8082

# Bound every container's local Docker logs. These limits apply independently
# per container and keep repeated rebuilds or upstream errors from filling the
# droplet disk.
SECURITY_RECIPES_LOG_MAX_SIZE=10m
SECURITY_RECIPES_LOG_MAX_FILES=5

# Optional Compose Fail2Ban overrides. The persistent database is stored in
# the fail2ban_data volume, so active bans survive container recreation.
FAIL2BAN_IMAGE=crazymax/fail2ban:latest
FAIL2BAN_LOG_LEVEL=INFO
FAIL2BAN_DB_PURGE_AGE=1d
TZ=UTC

# Keep Caddy's structured access log at a stable host path. The traffic report
# reads it without modification and the managed Fail2Ban jail uses it to
# enforce 404-abuse bans. Omitting this falls back to a Compose named volume,
# which host Fail2Ban cannot monitor directly.
SECURITY_RECIPES_TRAFFIC_LOGS_SOURCE=/var/log/caddy

# Hosted MCP metadata and index source. The public active route works with
# bundled Caddy, host Caddy, or nginx; forks should replace the hostname.
RECIPES_MCP_SOURCE_INDEX_URL=https://security-recipes.ai/api/recipes-index.json
RECIPES_MCP_ALLOWED_SOURCE_HOSTS=caddy,security-recipes,security-recipes-green,security-recipes-dev,security-recipes.ai,dev.security-recipes.ai
RECIPES_MCP_PUBLIC_BASE_URL=https://security-recipes.ai/mcp
RECIPES_MCP_PLAYBOOK_REGISTRY_PATH=./data/remediation_suite/playbooks.json
RECIPES_MCP_LOG_LEVEL=info
RECIPES_MCP_EAGER_REFRESH=false
