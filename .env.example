# DigitalOcean droplet / Docker Compose settings.
# Copy to .env on the droplet and edit values before `docker compose up -d --build`.
# Use the Docker Compose v2 plugin (`docker compose`). The legacy Python
# `docker-compose` v1 can crash on newer Docker image metadata.

# Public site URL used by the Eleventy build for absolute links.
SECURITY_RECIPES_BASE_URL=https://security-recipes.ai/
SECURITY_RECIPES_REPO_URL=https://github.com/stevologic/security-recipes.ai

# Bundled Caddy HTTPS proxy (docker/caddy/Caddyfile). With the profile on,
# `docker compose up -d --build` also starts Caddy: it owns ports 80/443,
# obtains the Let's Encrypt certificate for SECURITY_RECIPES_DOMAIN
# automatically, and renews it in the background. Remove the COMPOSE_PROFILES
# line if a host-level proxy (nginx + certbot, or host Caddy from
# scripts/setup_digitalocean_droplet.sh) already owns 80/443.
COMPOSE_PROFILES=caddy
SECURITY_RECIPES_DOMAIN=security-recipes.ai
SECURITY_RECIPES_ACME_EMAIL=admin@security-recipes.ai
# Host bind for the site container. Keep it loopback-only when a public nginx
# or Caddy reverse proxy owns ports 80/443. See README.nginx-letsencrypt.md for
# the nginx + Certbot deployment flow.
SECURITY_RECIPES_HTTP_PORT=127.0.0.1:8080

# Hosted MCP metadata and index source. Compose defaults to the internal site
# service so MCP searches the recipes built from this checkout. Set the URL and
# allow-list to your public domain only when running the MCP server standalone.
RECIPES_MCP_SOURCE_INDEX_URL=http://security-recipes/api/recipes-index.json
RECIPES_MCP_ALLOWED_SOURCE_HOSTS=security-recipes,security-recipes.ai
RECIPES_MCP_PUBLIC_BASE_URL=https://security-recipes.ai/mcp
RECIPES_MCP_PLAYBOOK_REGISTRY_PATH=./data/remediation_suite/playbooks.json
RECIPES_MCP_LOG_LEVEL=info
RECIPES_MCP_EAGER_REFRESH=false
