# DigitalOcean droplet / Docker Compose settings.
# Copy to .env on the droplet and edit values before `docker compose up -d --build`.
# Use the Docker Compose v2 plugin (`docker compose`). The legacy Python
# `docker-compose` v1 can crash on newer Docker image metadata.

# Public site URL used by Hugo when it builds absolute links.
SECURITY_RECIPES_BASE_URL=https://security-recipes.ai/
SECURITY_RECIPES_REPO_URL=https://github.com/stevologic/security-recipes.ai
# Host bind for the site container. Keep it loopback-only when a public nginx
# or Caddy reverse proxy owns ports 80/443. See README.nginx-letsencrypt.md for
# the nginx + Certbot deployment flow.
SECURITY_RECIPES_HTTP_PORT=127.0.0.1:8080

# Small droplets may OOM during Hugo minification. Leave minify enabled for
# normal production builds; set false and GOMAXPROCS=1 if Docker exits 137.
SECURITY_RECIPES_HUGO_MINIFY=true
SECURITY_RECIPES_HUGO_GOMAXPROCS=2

# Chatbot model-provider credentials are intentionally not configured here.
# The target architecture is BYO-key/browser-local for privacy and low cost.
# Users paste their own provider key in the browser; nginx may proxy the
# current request through /ai-provider-proxy/*, but it must remain pass-through
# network plumbing rather than a server-held-key chat backend.

# Hosted MCP metadata and index source. Set these to your domain when forking.
RECIPES_MCP_SOURCE_INDEX_URL=https://security-recipes.ai/recipes-index.json
RECIPES_MCP_ALLOWED_SOURCE_HOSTS=security-recipes.ai
RECIPES_MCP_PUBLIC_BASE_URL=https://security-recipes.ai/mcp
RECIPES_MCP_LOG_LEVEL=info
RECIPES_MCP_EAGER_REFRESH=false
